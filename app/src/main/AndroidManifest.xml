<?xml version="1.0" encoding="utf-8"?>
<!-- Slice 1 scaffold manifest. PlaybackService + MediaButtonReceiver arrive in slice 2. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Exactly the delivery-spec permission set; INTERNET is absent by design. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".JulicuentosApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Julicuentos">

        <!-- Slice 1 stub screen; replaced by the fragment-based UI in slice 3. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
