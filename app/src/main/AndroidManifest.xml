<?xml version="1.0" encoding="utf-8"?>
<!-- Slice 1 scaffold manifest + Slice 2 playback declarations.
     PlaybackService follows the media3 canonical manifest pattern: the service exposes
     the MediaSessionService interface action so MediaButtonReceiver can hand
     media-button intents to it on API 22 (design.md §5; S2.5/S2.6). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Exactly the delivery-spec permission set; INTERNET is absent by design. -->
    <!-- verify R-1 (owner decision): media3 AARs merge ACCESS_NETWORK_STATE; the app
         resolves only asset:/// and file:// sources, so the permission is removed to
         keep the delivery-spec surface. If a future media3 upgrade needs it, revert. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".JulicuentosApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Julicuentos">

        <!-- Slice 1 stub screen; replaced by the fragment-based UI in slice 3. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Playback core (slice 2). The ONLY ExoPlayer lives here (design D5/D8).
             exported=true so external media controls (notification shade, hardware keys)
             can drive the session on API 22. -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Media-button hardware keys / notification media-button intents on API 22
             (design D2). Startsthe service when not running. -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>