<?xml version="1.0" encoding="utf-8"?>
    <!-- Seek bar track (slice 4 S4.4, API-22-safe): a 4 dp line centred inside the 52 dp
         SeekBar. Two API-22 rules learned on device: (1) android:height on layer-list
         items is API 23+ and is ignored on the Fire (full-height slab); (2) item
         android:top/bottom insets are ALSO ignored on the Fire for the background layer,
         so BOTH layers use an InsetDrawable (insets honoured since API 1) to carve the
         4 dp line out of the 52 dp bar. Track slate @color/track, mint fill @color/accion,
         thumb 14 dp white dot (design pass 2). The thumb centres on the 4 dp line because
         AbsSeekBar vertically centres track and thumb in the same padded area. -->
    <layer-list xmlns:android="http://schemas.android.com/apk/res/android">
        <item
            android:id="@android:id/background">
            <inset android:insetTop="24dp" android:insetBottom="24dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/track" />
                    <corners android:radius="2dp" />
                </shape>
            </inset>
        </item>
        <item
            android:id="@android:id/progress"
            android:gravity="center_vertical">
            <clip>
                <inset android:insetTop="24dp" android:insetBottom="24dp">
                    <shape android:shape="rectangle">
                        <solid android:color="@color/accion" />
                        <corners android:radius="2dp" />
                    </shape>
                </inset>
            </clip>
        </item>
    </layer-list>
