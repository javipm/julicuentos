<?xml version="1.0" encoding="utf-8"?>
<!-- Story action bottom sheet (S3.5): title (Fredoka 18 sp) + 3 actions,
     each row >= 52 dp and 16 dp corners; play-now solid mint, add-to-queue mint
     outline, cancel soft text. Modal scrim arrives via the dialog theme dim. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sheet_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/sheet_padding"
    android:paddingEnd="@dimen/sheet_padding"
    android:paddingTop="@dimen/sheet_padding"
    android:paddingBottom="@dimen/sheet_padding">

    <TextView
        android:id="@+id/sheet_title"
        style="@style/TextAppearance.Jc.18"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2" />

    <TextView
        android:id="@+id/action_play_now"
        style="@style/TextAppearance.Jc.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sheet_padding"
        android:background="@drawable/bg_action_solid"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:minHeight="@dimen/action_row_min"
        android:text="@string/reproducir_ahora"
        android:textColor="@color/fondo" />

    <TextView
        android:id="@+id/action_add_queue"
        style="@style/TextAppearance.Jc.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/action_row_gap"
        android:background="@drawable/bg_action_outline"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:minHeight="@dimen/action_row_min"
        android:text="@string/anadir_a_la_cola"
        android:textColor="@color/accion" />

    <TextView
        android:id="@+id/action_cancel"
        style="@style/TextAppearance.Jc.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/action_row_gap"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:minHeight="@dimen/action_row_min"
        android:text="@string/cancelar"
        android:textColor="@color/textoSuave" />
</LinearLayout>