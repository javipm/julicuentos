<?xml version="1.0" encoding="utf-8"?>
<!-- Catalog home (S3.2): branded header + category picker, adaptive grid,
     in-flow miniplayer footer. Empty state when the selected category has no stories. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/header_padding_h"
        android:paddingEnd="@dimen/header_padding_h"
        android:paddingTop="@dimen/header_padding_top"
        android:paddingBottom="@dimen/header_padding_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.Jc.30"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/catalog_title" />

            <LinearLayout
                android:id="@+id/category_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_action_outline"
                android:clickable="true"
                android:contentDescription="@string/cambiar_categoria"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:maxWidth="220dp"
                android:minHeight="@dimen/min_touch"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/category_btn_label"
                    style="@style/TextAppearance.Jc.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="180dp"
                    android:textColor="@color/accion" />

                <ImageView
                    android:id="@+id/category_btn_chevron"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_down" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.Jc.14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/catalog_subtitle" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/catalog_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="true"
        android:paddingStart="@dimen/grid_padding_h"
        android:paddingEnd="@dimen/grid_padding_h"
        android:paddingTop="@dimen/grid_padding_top"
        android:paddingBottom="@dimen/grid_padding_bottom" />

    <LinearLayout
        android:id="@+id/catalog_no_access"
        style="@style/TextAppearance.Jc.14"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/header_padding_h"
        android:textAlignment="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/catalog_no_access_title"
            style="@style/TextAppearance.Jc.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/catalog_no_access_title" />

        <TextView
            android:id="@+id/catalog_no_access_body"
            style="@style/TextAppearance.Jc.14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/catalog_no_access_body" />

        <TextView
            android:id="@+id/catalog_no_access_action"
            style="@style/TextAppearance.Jc.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_action_solid"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:minHeight="@dimen/action_row_min"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/catalog_no_access_action"
            android:textColor="@color/fondo" />
    </LinearLayout>

    <TextView
        android:id="@+id/catalog_empty"
        style="@style/TextAppearance.Jc.14"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="@dimen/header_padding_h"
        android:text="@string/catalog_empty"
        android:textAlignment="center"
        android:visibility="gone" />

    <com.julicuentos.app.ui.catalog.MiniPlayerView
        android:id="@+id/mini_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
