<?xml version="1.0" encoding="utf-8"?>
<!-- Player portrait stack (tasks S4.1; specs/theme-design "Dual-orientation player
     layouts"): centered NON-SCROLLING ConstraintLayout — content fits the 800×752 dp
     Fire portrait. The seek bar is structurally OUTSIDE any scroll container, and this file has
     NO ScrollView at all (specs/playback "Seek = drag-preview + commit-on-release";
     S4.1 "no scroll"). Top bar: ✕ back (52 dp(, centered eyebrow "REPRODUCIENDO"
     (12 sp soft(, 52 dp spacer. Content: cover halo → title (Fredoka 24 sp, 2 lines( →
     description (Nunito 16 sp soft, elided to @integer/player_desc_max_lines lines( → seek block
     (2 × 12 sp labels + SeekBar( → transport → "Ver cola" pill + timer-status line
     (hidden until slice 5 wires the timer(. Empty/Idle and error states overlay the same
     content region. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <!-- Top bar: ✕ back, centered eyebrow, balancing spacer. -->
    <LinearLayout
        android:id="@+id/player_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/player_back"
            android:layout_width="@dimen/player_top_bar_size"
            android:layout_height="@dimen/player_top_bar_size"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="@dimen/player_transport_icon"
                android:layout_height="@dimen/player_transport_icon"
                android:layout_gravity="center"
                android:contentDescription="@string/cerrar_reproductor"
                android:src="@drawable/ic_close" />
        </FrameLayout>

        <TextView
            android:id="@+id/player_eyebrow"
            style="@style/TextAppearance.Jc.12"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/reproduciendo"
            android:textColor="@color/textoSuave" />

        <View
            android:layout_width="@dimen/player_top_bar_size"
            android:layout_height="@dimen/player_top_bar_size" />
    </LinearLayout>

    <!-- Player content stack (all interactive layouts are NON-scrolling by design(. -->
    <LinearLayout
        android:id="@+id/player_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="@dimen/player_bottom_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/player_top_bar">

        <!-- Cover halo: rounded square 340 dp + square-ring progress (specs/theme-design.-->
        <com.julicuentos.app.ui.player.CoverHaloView
            android:id="@+id/player_cover_wrap"
            android:layout_width="@dimen/player_cover"
            android:layout_height="@dimen/player_cover">

            <ImageView
                android:id="@+id/player_cover_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />
        </com.julicuentos.app.ui.player.CoverHaloView>

        <!-- Mint loading line (state Loading; specs/playback "State machine drives the player UI"(. -->
        <TextView
            android:id="@+id/player_loading"
            style="@style/TextAppearance.Jc.14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/player_section_gap"
            android:text="@string/cargando_audio"
            android:textColor="@color/accion"
            android:visibility="gone" />

        <TextView
            android:id="@+id/player_title"
            style="@style/TextAppearance.Jc.24"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/player_section_gap"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/player_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/player_desc_gap"
            android:ellipsize="end"
            android:fontFamily="@font/nunitosans"
            android:gravity="center"
            android:maxLines="@integer/player_desc_max_lines"
            android:textAlignment="center"
            android:textColor="@color/textoSuave"
            android:textSize="16sp" />

        <!-- Seek block (NO scrolling container anywhere; spec seek gesture contract(.-->
        <LinearLayout
            android:id="@+id/player_seek_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/player_position"
                    style="@style/TextAppearance.Jc.12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/player_duration"
                    style="@style/TextAppearance.Jc.12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/player_seek"
                android:layout_width="match_parent"
                android:layout_height="@dimen/min_touch"
                android:layout_marginTop="@dimen/player_seek_labels_gap"
                android:contentDescription="@string/seek_bar"
                android:max="1"
                android:progress="0"
                android:progressDrawable="@drawable/bg_seekbar_track"
                android:splitTrack="false"
                android:thumb="@drawable/bg_seek_thumb" />
        </LinearLayout>

        <!-- Transport row: timer, −15, play/pause (mint circle(, +15, queue. -->
        <LinearLayout
            android:id="@+id/player_transport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/player_transport_top_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/player_timer_btn"
                android:layout_width="@dimen/min_touch"
                android:layout_height="@dimen/min_touch"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="@dimen/player_transport_icon"
                    android:layout_height="@dimen/player_transport_icon"
                    android:layout_gravity="center"
                    android:contentDescription="@string/temporizador"
                    android:src="@drawable/ic_timer" />
            </FrameLayout>

            <Space
                android:layout_width="@dimen/player_transport_gap"
                android:layout_height="1dp" />

            <FrameLayout
                android:id="@+id/player_skip_back_btn"
                android:layout_width="@dimen/min_touch"
                android:layout_height="@dimen/min_touch"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="@dimen/player_transport_icon"
                    android:layout_height="@dimen/player_transport_icon"
                    android:layout_gravity="center"
                    android:contentDescription="@string/notif_skip_back_15"
                    android:src="@drawable/ic_act_skip_back" />
            </FrameLayout>

            <Space
                android:layout_width="@dimen/player_transport_gap"
                android:layout_height="1dp" />

            <FrameLayout
                android:id="@+id/player_play_btn"
                android:layout_width="@dimen/player_play_size"
                android:layout_height="@dimen/player_play_size"
                android:background="@drawable/bg_play_circle"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/player_play_icon"
                    android:layout_width="@dimen/player_icon_play"
                    android:layout_height="@dimen/player_icon_play"
                    android:layout_gravity="center"
                    android:contentDescription="@string/play"
                    android:src="@drawable/ic_play_dark" />
            </FrameLayout>

            <Space
                android:layout_width="@dimen/player_transport_gap"
                android:layout_height="1dp" />

            <FrameLayout
                android:id="@+id/player_skip_fwd_btn"
                android:layout_width="@dimen/min_touch"
                android:layout_height="@dimen/min_touch"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="@dimen/player_transport_icon"
                    android:layout_height="@dimen/player_transport_icon"
                    android:layout_gravity="center"
                    android:contentDescription="@string/notif_skip_fwd_15"
                    android:src="@drawable/ic_act_skip_fwd" />
            </FrameLayout>

            <Space
                android:layout_width="@dimen/player_transport_gap"
                android:layout_height="1dp" />

            <FrameLayout
                android:id="@+id/player_queue_btn"
                android:layout_width="@dimen/min_touch"
                android:layout_height="@dimen/min_touch"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/player_queue_icon"
                    android:layout_width="@dimen/player_transport_icon"
                    android:layout_height="@dimen/player_transport_icon"
                    android:layout_gravity="center"
                    android:contentDescription="@string/anadir_a_la_cola"
                    android:src="@drawable/ic_add" />
            </FrameLayout>
        </LinearLayout>

        <!-- "Ver cola" pill → queue (slice 5 wires the queue screen State(.-->
        <TextView
            android:id="@+id/player_ver_cola"
            style="@style/TextAppearance.Jc.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/player_pill_top_gap"
            android:background="@drawable/bg_action_outline"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:minHeight="@dimen/min_touch"
            android:minWidth="@dimen/min_touch"
            android:paddingStart="@dimen/player_pill_padding_h"
            android:paddingEnd="@dimen/player_pill_padding_h"
            android:text="@string/ver_cola"
            android:textColor="@color/accion" />

        <!-- Timer countdown line (peach; hidden until slice 5 wires the timer(. -->
        <TextView
            android:id="@+id/player_timer_line"
            style="@style/TextAppearance.Jc.14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/player_timer_line_gap"
            android:textColor="@color/temporizador"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Empty/Idle state: no current story (tasks S4.5(.-->
    <LinearLayout
        android:id="@+id/player_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/player_top_bar">

        <TextView
            style="@style/TextAppearance.Jc.16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/no_hay_cuento"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/player_empty_back"
            style="@style/TextAppearance.Jc.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/player_section_gap"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:minHeight="@dimen/min_touch"
            android:minWidth="@dimen/min_touch"
            android:paddingStart="@dimen/player_pill_padding_h"
            android:paddingEnd="@dimen/player_pill_padding_h"
            android:text="@string/volver_al_catalogo"
            android:textColor="@color/accion" />
    </LinearLayout>

    <!-- Error card (specs/playback "Error handling (bundled audio only"; player binds it(. -->
    <LinearLayout
        android:id="@+id/player_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/player_top_bar">

        <TextView
            android:id="@+id/player_error_msg"
            style="@style/TextAppearance.Jc.16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/player_error_retry"
            style="@style/TextAppearance.Jc.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/player_section_gap"
            android:background="@drawable/bg_action_solid"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:minHeight="@dimen/min_touch"
            android:minWidth="@dimen/min_touch"
            android:paddingStart="@dimen/player_pill_padding_h"
            android:paddingEnd="@dimen/player_pill_padding_h"
            android:text="@string/reintentar"
            android:textColor="@color/fondo" />

        <TextView
            android:id="@+id/player_error_close"
            style="@style/TextAppearance.Jc.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/player_transport_gap"
            android:background="@drawable/bg_action_outline"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:minHeight="@dimen/min_touch"
            android:minWidth="@dimen/min_touch"
            android:paddingStart="@dimen/player_pill_padding_h"
            android:paddingEnd="@dimen/player_pill_padding_h"
            android:text="@string/cerrar"
            android:textColor="@color/accion" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>