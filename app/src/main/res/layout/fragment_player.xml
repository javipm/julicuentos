<?xml version="1.0" encoding="utf-8"?>
<!-- Player portrait stack (design-consult-opus.md C7; specs/theme-design
     "Dual-orientation player layouts"): centered NON-SCROLLING ConstraintLayout.
     Top bar (✕ 28 dp icon in a 56 dp circle target + eyebrow) -> cover OUTSIDE the
     panel (match_parent x 396 dp, 24 dp side margins) -> 24 dp gap -> the #28244B
     control panel (match_parent, 24 dp margins, 24 dp padding) with the same strict
     8/16/24 ladder as landscape: title 0 / desc 8 / seek 24 / transport 24 /
     chips 16 / timer line 16; seek labels BELOW the bar. Height budget ≈ 958 dp of
     1280 — no scrolling anywhere (specs/playback; S4.1 "no scroll"). All bind ids
     match the landscape layout (no runtime view surgery by qualifiers). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <!-- Top bar: ✕ back (56 dp circle surface), centered eyebrow, balancing spacer. -->
    <LinearLayout
        android:id="@+id/player_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/player_back"
            android:layout_width="@dimen/player_top_bar_size"
            android:layout_height="@dimen/player_top_bar_size"
            android:background="@drawable/bg_circle_surface"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="@dimen/player_close_icon"
                android:layout_height="@dimen/player_close_icon"
                android:layout_gravity="center"
                android:contentDescription="@string/cerrar_reproductor"
                android:src="@drawable/ic_close" />
        </FrameLayout>

        <TextView
            android:id="@+id/player_eyebrow"
            style="@style/TextAppearance.Jc.12"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/reproduciendo"
            android:textColor="@color/textoSuave" />

        <View
            android:layout_width="@dimen/player_top_bar_size"
            android:layout_height="@dimen/player_top_bar_size" />
    </LinearLayout>

    <!-- Cover halo OUTSIDE the panel: match_parent x 396 dp, 24 dp side margins
         (design-consult C7); FIT_CENTER art on a matte, rect ring (C2). -->
    <com.julicuentos.app.ui.player.CoverHaloView
        android:id="@+id/player_cover_wrap"
        android:layout_width="match_parent"
        android:layout_height="@dimen/player_cover_port_h"
        android:layout_marginStart="@dimen/player_port_inset"
        android:layout_marginEnd="@dimen/player_port_inset"
        app:layout_constraintTop_toBottomOf="@id/player_top_bar">

        <ImageView
            android:id="@+id/player_cover_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
    </com.julicuentos.app.ui.player.CoverHaloView>

    <!-- Control panel (design-consult C7): match_parent, 24 dp margins, 24 dp
         padding, 24 dp gap over the cover; identical ladder to landscape. -->
    <LinearLayout
        android:id="@+id/player_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/player_port_inset"
        android:layout_marginEnd="@dimen/player_port_inset"
        android:layout_marginTop="@dimen/player_cover_panel_gap"
        android:background="@drawable/bg_panel"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/player_panel_pad"
        app:layout_constraintTop_toBottomOf="@id/player_cover_wrap">

        <!-- Mint loading line (state Loading). -->
        <TextView
            android:id="@+id/player_loading"
            style="@style/TextAppearance.Jc.14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cargando_audio"
            android:textColor="@color/accion"
            android:visibility="gone" />

        <TextView
            android:id="@+id/player_title"
            style="@style/TextAppearance.Jc.28"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/player_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/player_desc_gap"
            android:ellipsize="end"
            android:fontFamily="@font/nunitosans"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:maxLines="@integer/player_desc_max_lines"
            android:textAlignment="center"
            android:textColor="@color/textoSuave"
            android:textSize="16sp" />

        <!-- Seek block: thin bar, time labels BELOW it, single inset (the 24 dp
             panel padding is the only inset). -->
        <LinearLayout
            android:id="@+id/player_seek_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/player_seek_top_gap"
            android:orientation="vertical">

            <SeekBar
                android:id="@+id/player_seek"
                android:layout_width="match_parent"
                android:layout_height="@dimen/min_touch"
                android:contentDescription="@string/seek_bar"
                android:max="1"
                android:paddingEnd="0dp"
                android:paddingStart="0dp"
                android:progress="0"
                android:progressDrawable="@drawable/bg_seekbar_track"
                android:splitTrack="false"
                android:thumb="@drawable/bg_seek_thumb" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/player_seek_labels_gap"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/player_position"
                    style="@style/TextAppearance.Jc.12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/player_duration"
                    style="@style/TextAppearance.Jc.12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- Transport primary row: -15 / play / +15 only (design-consult C3). -->
        <LinearLayout
            android:id="@+id/player_transport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/player_transport_top_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/player_skip_back_btn"
                android:layout_width="@dimen/player_transport_btn_size"
                android:layout_height="@dimen/player_transport_btn_size"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="@dimen/player_transport_icon"
                    android:layout_height="@dimen/player_transport_icon"
                    android:layout_gravity="center"
                    android:contentDescription="@string/notif_skip_back_15"
                    android:src="@drawable/ic_act_skip_back" />
            </FrameLayout>

            <Space
                android:layout_width="@dimen/player_transport_gap"
                android:layout_height="1dp" />

            <FrameLayout
                android:id="@+id/player_play_btn"
                android:layout_width="@dimen/player_play_size"
                android:layout_height="@dimen/player_play_size"
                android:background="@drawable/bg_play_circle"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/player_play_icon"
                    android:layout_width="@dimen/player_icon_play"
                    android:layout_height="@dimen/player_icon_play"
                    android:layout_gravity="center"
                    android:contentDescription="@string/play"
                    android:src="@drawable/ic_play_dark" />
            </FrameLayout>

            <Space
                android:layout_width="@dimen/player_transport_gap"
                android:layout_height="1dp" />

            <FrameLayout
                android:id="@+id/player_skip_fwd_btn"
                android:layout_width="@dimen/player_transport_btn_size"
                android:layout_height="@dimen/player_transport_btn_size"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="@dimen/player_transport_icon"
                    android:layout_height="@dimen/player_transport_icon"
                    android:layout_gravity="center"
                    android:contentDescription="@string/notif_skip_fwd_15"
                    android:src="@drawable/ic_act_skip_fwd" />
            </FrameLayout>
        </LinearLayout>

        <!-- Labelled chip row (design-consult C3), identical ids to landscape. -->
        <LinearLayout
            android:id="@+id/player_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/player_pill_top_gap"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/player_timer_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_control"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="@dimen/min_touch"
                android:orientation="horizontal"
                android:paddingEnd="16dp"
                android:paddingStart="16dp">

                <ImageView
                    android:id="@+id/player_timer_icon"
                    android:layout_width="@dimen/player_chip_icon"
                    android:layout_height="@dimen/player_chip_icon"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="@string/temporizador"
                    android:src="@drawable/ic_timer"
                    android:tint="@color/temporizador" />

                <TextView
                    android:id="@+id/player_timer_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/player_chip_gap"
                    android:fontFamily="@font/nunitosans"
                    android:gravity="center_vertical"
                    android:text="@string/temporizador"
                    android:textColor="@color/temporizador"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/player_queue_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/player_chip_gap"
                android:background="@drawable/bg_chip_control"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="@dimen/min_touch"
                android:orientation="horizontal"
                android:paddingEnd="16dp"
                android:paddingStart="16dp">

                <ImageView
                    android:layout_width="@dimen/player_chip_icon"
                    android:layout_height="@dimen/player_chip_icon"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="@string/anadir_a_la_cola"
                    android:src="@drawable/ic_add"
                    android:tint="@color/texto" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/player_chip_gap"
                    android:fontFamily="@font/nunitosans"
                    android:gravity="center_vertical"
                    android:text="@string/anadir"
                    android:textColor="@color/texto"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/player_ver_cola"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/player_chip_gap"
                android:background="@drawable/bg_chip_control"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="@dimen/min_touch"
                android:orientation="horizontal"
                android:paddingEnd="16dp"
                android:paddingStart="16dp">

                <ImageView
                    android:layout_width="@dimen/player_chip_icon"
                    android:layout_height="@dimen/player_chip_icon"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="@string/ver_cola"
                    android:src="@drawable/ic_list"
                    android:tint="@color/accion" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/player_chip_gap"
                    android:fontFamily="@font/nunitosans"
                    android:gravity="center_vertical"
                    android:text="@string/ver_cola"
                    android:textColor="@color/accion"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Timer countdown line (peach; wired in PlayerFragment when the timer arms). -->
        <TextView
            android:id="@+id/player_timer_line"
            style="@style/TextAppearance.Jc.14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/player_timer_line_gap"
            android:textColor="@color/temporizador"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Empty/Idle state overlay (covers the content region below the top bar). -->
    <LinearLayout
        android:id="@+id/player_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/player_top_bar">

        <TextView
            style="@style/TextAppearance.Jc.16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/no_hay_cuento"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/player_empty_back"
            style="@style/TextAppearance.Jc.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/player_section_gap"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:minHeight="@dimen/min_touch"
            android:minWidth="@dimen/min_touch"
            android:paddingEnd="@dimen/player_pill_padding_h"
            android:paddingStart="@dimen/player_pill_padding_h"
            android:text="@string/volver_al_catalogo"
            android:textColor="@color/accion" />
    </LinearLayout>

    <!-- Error card overlay. -->
    <LinearLayout
        android:id="@+id/player_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/player_top_bar">

        <TextView
            android:id="@+id/player_error_msg"
            style="@style/TextAppearance.Jc.16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/player_error_retry"
            style="@style/TextAppearance.Jc.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/player_section_gap"
            android:background="@drawable/bg_action_solid"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:minHeight="@dimen/min_touch"
            android:minWidth="@dimen/min_touch"
            android:paddingEnd="@dimen/player_pill_padding_h"
            android:paddingStart="@dimen/player_pill_padding_h"
            android:text="@string/reintentar"
            android:textColor="@color/fondo" />

        <TextView
            android:id="@+id/player_error_close"
            style="@style/TextAppearance.Jc.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/player_transport_gap"
            android:background="@drawable/bg_action_outline"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:minHeight="@dimen/min_touch"
            android:minWidth="@dimen/min_touch"
            android:paddingEnd="@dimen/player_pill_padding_h"
            android:paddingStart="@dimen/player_pill_padding_h"
            android:text="@string/cerrar"
            android:textColor="@color/accion" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
