<?xml version="1.0" encoding="utf-8"?>
<!-- One category row inside dialog_category.xml; inflated once per category. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/category_row"
    style="@style/TextAppearance.Jc.Button"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/action_row_gap"
    android:background="@drawable/bg_row_surface"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical|start"
    android:minHeight="@dimen/action_row_min"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:textColor="@color/texto" />
