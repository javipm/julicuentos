<?xml version="1.0" encoding="utf-8"?>
<!-- Queue row (design-consult-opus.md C9/C12; specs/queue "Queue screen"): #28244B
     surface (20 dp corners), min height 76 dp, 60 dp matte cover (fitCenter, rounded
     via clipToOutline), Fredoka 16 sp 2-line title + Nunito 12 sp duration line,
     32 dp order-number circle (mint, peach for the currently-playing row), and
     up/down/remove buttons (26 dp glyphs in 52 dp targets; chevrons soft, remove
     peach). Rows never subscribe to progress. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/queue_gap"
    android:background="@drawable/bg_row_surface"
    android:gravity="center_vertical"
    android:minHeight="@dimen/queue_row_min_height"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/queue_index"
        android:layout_width="@dimen/queue_index_size"
        android:layout_height="@dimen/queue_index_size"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_index_circle"
        android:fontFamily="@font/fredoka"
        android:gravity="center"
        android:textColor="@color/fondo"
        android:textSize="18sp" />

    <ImageView
        android:id="@+id/queue_cover"
        android:layout_width="@dimen/queue_cover"
        android:layout_height="@dimen/queue_cover"
        android:background="@drawable/bg_cover_matte"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="@dimen/queue_padding_h"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/queue_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/fredoka"
            android:maxLines="2"
            android:textColor="@color/texto"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/queue_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/nunitosans"
            android:maxLines="1"
            android:textColor="@color/textoSuave"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/queue_move_up"
        android:layout_width="@dimen/min_touch"
        android:layout_height="@dimen/min_touch"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <ImageView
            android:layout_width="@dimen/queue_row_icon"
            android:layout_height="@dimen/queue_row_icon"
            android:layout_gravity="center"
            android:contentDescription="@string/queue_move_up"
            android:src="@drawable/ic_chevron_up"
            android:tint="@color/textoSuave" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/queue_move_down"
        android:layout_width="@dimen/min_touch"
        android:layout_height="@dimen/min_touch"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <ImageView
            android:layout_width="@dimen/queue_row_icon"
            android:layout_height="@dimen/queue_row_icon"
            android:layout_gravity="center"
            android:contentDescription="@string/queue_move_down"
            android:src="@drawable/ic_chevron_down"
            android:tint="@color/textoSuave" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/queue_remove"
        android:layout_width="@dimen/min_touch"
        android:layout_height="@dimen/min_touch"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <ImageView
            android:layout_width="@dimen/queue_row_icon"
            android:layout_height="@dimen/queue_row_icon"
            android:layout_gravity="center"
            android:contentDescription="@string/queue_remove"
            android:src="@drawable/ic_close_peach" />
    </FrameLayout>
</LinearLayout>
