<?xml version="1.0" encoding="utf-8"?>
<!-- Story card (design-consult-opus.md C5): framed tile. Fixed 16:9 cover on a
     matte (every card identical height, grid rows align), Fredoka 16 sp title
     (fixed 2 lines), Nunito 13 sp 2-line synopsis closing the card (no dead band),
     and the 52 dp overflow button moved ONTO the cover top-right. Flat: depth is
     surface-on-background; pill/chip ride the matte - no elevation (theme-design). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:padding="8dp">

    <ImageView
        android:id="@+id/story_cover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_cover_matte"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/pill_sonando"
        style="@style/TextAppearance.Jc.Badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/overlay_margin"
        android:layout_marginStart="@dimen/overlay_margin"
        android:background="@drawable/bg_pill_sonando"
        android:paddingStart="@dimen/pill_padding_h"
        android:paddingEnd="@dimen/pill_padding_h"
        android:paddingTop="@dimen/pill_padding_v"
        android:paddingBottom="@dimen/pill_padding_v"
        android:text="@string/sonando"
        android:textColor="@color/fondo"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/story_cover"
        app:layout_constraintStart_toStartOf="@id/story_cover" />

    <TextView
        android:id="@+id/chip_duration"
        style="@style/TextAppearance.Jc.12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/overlay_margin"
        android:layout_marginEnd="@dimen/overlay_margin"
        android:background="@drawable/bg_chip_duration"
        android:paddingStart="@dimen/chip_padding_h"
        android:paddingEnd="@dimen/chip_padding_h"
        android:paddingTop="@dimen/chip_padding_v"
        android:paddingBottom="@dimen/chip_padding_v"
        android:textColor="@color/texto"
        app:layout_constraintBottom_toBottomOf="@id/story_cover"
        app:layout_constraintEnd_toEndOf="@id/story_cover" />

    <TextView
        android:id="@+id/story_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginTop="@dimen/card_title_top"
        android:ellipsize="end"
        android:fontFamily="@font/fredoka"
        android:lines="2"
        android:textColor="@color/texto"
        android:textSize="@dimen/card_title_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/story_cover" />

    <TextView
        android:id="@+id/story_synopsis"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="@font/nunitosans"
        android:lineSpacingExtra="1dp"
        android:lines="2"
        android:textColor="@color/textoSuave"
        android:textSize="@dimen/card_desc_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/story_title" />

    <!-- Overflow button rides the cover top-right: 52 dp circle scrim target,
         20 dp glyph (design-consult C5). -->
    <FrameLayout
        android:id="@+id/overflow_btn"
        android:layout_width="@dimen/min_touch"
        android:layout_height="@dimen/min_touch"
        android:layout_margin="2dp"
        android:background="@drawable/bg_overflow_circle"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintEnd_toEndOf="@id/story_cover"
        app:layout_constraintTop_toTopOf="@id/story_cover">

        <ImageView
            android:layout_width="@dimen/overflow_icon"
            android:layout_height="@dimen/overflow_icon"
            android:layout_gravity="center"
            android:contentDescription="@string/catalog_overflow"
            android:src="@drawable/ic_overflow" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
